{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SparkAtlas publication metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "article_id",
    "revision",
    "status",
    "reviewed_at",
    "reviewer",
    "scope",
    "sources",
    "claims"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "article_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "source-reviewed",
        "community-reported"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "title",
          "author",
          "accessed_at",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[1-9][0-9]*$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "kind": {
            "enum": [
              "official-docs",
              "forum"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
